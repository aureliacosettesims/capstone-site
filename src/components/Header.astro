---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Normalize path for comparison
const normalize = (path: string) => {
  if (path === '/' || path === '') return '/';
  return path.replace(/\/$/, '');
};

const normalizedCurrent = normalize(currentPath);

const navLinks = [
  { href: '/', label: 'Work / Gallery', match: (p: string) => p === '/' || p.startsWith('/work') },
  { href: '/resume', label: 'Resume', match: (p: string) => p.startsWith('/resume') },
  { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
];
---

<header class="sticky top-0 z-40 bg-paper-100/90 backdrop-blur-md border-b border-artisan-300 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-20 sm:h-24 flex items-center justify-between">
    <!-- Left: Identity -->
    <a href="/" class="group flex flex-col justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper-800 rounded py-1">
      <span class="font-serif text-2xl sm:text-3xl text-paper-900 tracking-tight font-medium group-hover:text-artisan-700 transition-colors">
        Aurelia Cosette Sims
      </span>
      <span class="text-[11px] sm:text-xs font-sans tracking-widest uppercase text-artisan-600 mt-0.5 font-medium">
        Craft Artisan &amp; Visual Artist
      </span>
    </a>

    <!-- Right: Desktop Navigation Links -->
    <nav class="hidden md:flex items-center space-x-8 lg:space-x-10 text-sm font-sans tracking-wide">
      {navLinks.map((link) => {
        const isActive = link.match(normalizedCurrent);
        return (
          <a
            href={link.href}
            class={`relative py-1 text-sm tracking-wide transition-colors ${
              isActive
                ? 'text-paper-900 font-medium'
                : 'text-paper-700 hover:text-paper-900'
            } focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper-800 rounded`}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.label}
            {isActive && (
              <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-paper-900 rounded-full" />
            )}
          </a>
        );
      })}

      <a
        href="/AureliaS.resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs uppercase tracking-wider font-semibold text-paper-900 border border-artisan-300 hover:border-paper-900 rounded transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper-800"
      >
        <svg class="w-3.5 h-3.5 text-artisan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        PDF
      </a>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 text-paper-700 hover:text-paper-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper-800 rounded-lg"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <svg class="w-6 h-6 open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer Backdrop & Panel -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-paper-900/40 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 bottom-0 w-4/5 max-w-sm bg-paper-100 z-50 shadow-2xl border-l border-artisan-300 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col"
  aria-label="Mobile Navigation"
  aria-hidden="true"
>
  <!-- Drawer Header -->
  <div class="p-6 border-b border-artisan-300 flex items-center justify-between">
    <div>
      <span class="font-serif text-xl text-paper-900 font-medium">Aurelia Cosette Sims</span>
      <p class="text-[10px] tracking-widest uppercase text-artisan-600 font-medium">Craft Artisan &amp; Visual Artist</p>
    </div>
    <button
      id="close-drawer-btn"
      type="button"
      class="p-2 text-paper-700 hover:text-paper-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper-800 rounded"
      aria-label="Close navigation menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Drawer Links -->
  <nav class="flex-1 px-6 py-8 space-y-4">
    {navLinks.map((link) => {
      const isActive = link.match(normalizedCurrent);
      return (
        <a
          href={link.href}
          class={`block py-3 px-4 rounded-md text-base tracking-wide transition-colors ${
            isActive
              ? 'bg-paper-200 text-paper-900 font-medium'
              : 'text-paper-800 hover:bg-paper-200/80 hover:text-paper-900'
          }`}
          aria-current={isActive ? 'page' : undefined}
        >
          {link.label}
        </a>
      );
    })}

    <div class="pt-6 border-t border-artisan-300">
      <a
        href="/AureliaS.resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-md border border-artisan-400 text-sm font-semibold text-paper-900 hover:bg-paper-200 transition-colors"
      >
        <svg class="w-4 h-4 text-artisan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Download PDF Resume
      </a>
    </div>
  </nav>

  <!-- Drawer Footer -->
  <div class="p-6 border-t border-artisan-300 bg-paper-200/50 text-xs text-paper-700 space-y-1">
    <p>Northern Arizona University</p>
    <p>Flagstaff, Arizona</p>
    <a href="/about#contact" class="text-paper-900 font-medium hover:underline block pt-1">
      Contact &amp; Inquiries &rarr;
    </a>
  </div>
</aside>

<script>
  function setupDrawer() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-drawer-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');
    const openIcon = menuBtn?.querySelector('.open-icon');
    const closeIcon = menuBtn?.querySelector('.close-icon');

    if (!menuBtn || !drawer || !backdrop) return;

    function openMenu() {
      drawer?.classList.remove('translate-x-full');
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');
      menuBtn?.setAttribute('aria-expanded', 'true');
      drawer?.setAttribute('aria-hidden', 'false');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      drawer?.classList.add('translate-x-full');
      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      menuBtn?.setAttribute('aria-expanded', 'false');
      drawer?.setAttribute('aria-hidden', 'true');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) closeMenu();
      else openMenu();
    });

    closeBtn?.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }

  // Run on page load and astro:page-load (if view transitions are used)
  setupDrawer();
  document.addEventListener('astro:page-load', setupDrawer);
</script>
