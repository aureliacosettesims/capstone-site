---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-artisan-300 bg-paper-100 text-paper-800">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8 items-start">
      <!-- Left column: Artist Branding -->
      <div class="md:col-span-5 space-y-3">
        <a href="/" class="inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper-800 rounded">
          <span class="font-serif text-2xl text-paper-900 tracking-tight font-medium hover:text-artisan-700 transition-colors">
            Aurelia Cosette Sims
          </span>
        </a>
        <p class="text-xs uppercase tracking-widest text-artisan-600 font-sans font-medium">
          Craft Artisan &amp; Visual Artist
        </p>
        <p class="text-sm text-paper-700 max-w-sm leading-relaxed pt-2">
          Technical Theater &amp; Sculpture at Northern Arizona University. Specializing in costume crafts, puppetry fabrication, printmaking, and tactile studio arts.
        </p>
      </div>

      <!-- Center column: Navigation Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs uppercase tracking-widest font-semibold text-paper-900 font-mono">
          Navigation
        </h4>
        <ul class="space-y-2 text-sm text-paper-700">
          <li>
            <a href="/" class="hover:text-artisan-700 transition-colors">Work / Gallery</a>
          </li>
          <li>
            <a href="/resume" class="hover:text-artisan-700 transition-colors">Resume &amp; Theatrical Credits</a>
          </li>
          <li>
            <a href="/about" class="hover:text-artisan-700 transition-colors">About &amp; Studio Practice</a>
          </li>
          <li>
            <a href="/AureliaS.resume.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-artisan-700 transition-colors inline-flex items-center gap-1 font-medium">
              Download PDF Resume
              <svg class="w-3 h-3 text-artisan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Right column: Location & Contact -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs uppercase tracking-widest font-semibold text-paper-900 font-mono">
          Studio &amp; Contact
        </h4>
        <div class="space-y-2 text-sm text-paper-700">
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-artisan-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Flagstaff, Arizona · Northern Arizona University
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-artisan-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            <a href="/about#contact" class="hover:text-artisan-700 transition-colors font-medium">
              Contact &amp; Inquiries
            </a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-artisan-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="1.75"></rect>
              <path stroke-width="1.75" d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2" stroke-linecap="round"></line>
            </svg>
            <a href="https://instagram.com/aureliacosette" target="_blank" rel="noopener noreferrer" class="hover:text-artisan-700 transition-colors font-medium">
              Instagram
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom sub-bar -->
    <div class="mt-14 pt-8 border-t border-artisan-300/80 flex flex-col sm:flex-row items-center justify-between text-xs text-artisan-600 gap-4">
      <p>&copy; {currentYear} Aurelia Cosette Sims. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <span>Northern Arizona University</span>
        <span class="text-artisan-300">·</span>
        <a href="/admin" class="hover:text-paper-900 transition-colors">CMS Admin</a>
      </div>
    </div>
  </div>
</footer>
