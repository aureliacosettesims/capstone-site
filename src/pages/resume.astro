---
import BaseLayout from '../layouts/BaseLayout.astro';
import resumeData from '../data/resume.json';
---

<BaseLayout
  title="Resume & Theatrical Credits — Aurelia Cosette Sims"
  description="Theatrical fabrication credits, sculpture expertise, and technical skills of Aurelia Cosette Sims (Craft Artisan & Visual Artist, Northern Arizona University)."
  currentPath="/resume"
>
  <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 py-12 sm:py-16">
    <!-- Top Action Bar: Heading & Prominent PDF Download Button -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-8 border-b border-artisan-300">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-paper-600 font-semibold block mb-2">
          Curriculum Vitae
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl text-paper-900 font-medium tracking-tight">
          Resume &amp; Theatrical Credits
        </h1>
        <p class="text-sm sm:text-base text-paper-600 font-sans mt-2">
          Aurelia Cosette Sims · Craft Artisan &amp; Visual Artist · Flagstaff, AZ
        </p>
      </div>

      <!-- Prominent "Download PDF Resume" button -->
      <div class="shrink-0">
        <a
          href={resumeData.pdfUrl}
          target="_blank"
          download="Aurelia_Sims_Resume.pdf"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-lg bg-paper-900 text-paper-50 hover:bg-artisan-700 font-medium text-sm tracking-wide shadow-xs transition-all duration-200 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-paper-800"
        >
          <svg class="w-5 h-5 text-paper-200 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span>Download PDF Resume</span>
        </a>
      </div>
    </div>

    <!-- Education Section -->
    <section class="py-12 border-b border-artisan-300">
      <h2 class="text-xs font-mono uppercase tracking-widest text-paper-600 font-semibold mb-6">
        Education
      </h2>
      <div class="bg-paper-50 p-6 sm:p-8 rounded-xl border border-artisan-300 shadow-2xs">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
          <div>
            <h3 class="font-serif text-2xl text-paper-900 font-medium">
              {resumeData.education.institution}
            </h3>
            <p class="text-sm font-sans font-medium text-paper-900 mt-1">
              Major in {resumeData.education.majors.join(' and ')}
            </p>
            <p class="text-xs text-paper-600 font-sans mt-0.5">
              {resumeData.education.location}
            </p>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium bg-paper-200 text-paper-900 border border-artisan-300 shrink-0 self-start">
            Expected {resumeData.education.expectedGraduation}
          </span>
        </div>
        <p class="text-sm text-paper-700 font-sans mt-4 leading-relaxed max-w-2xl">
          {resumeData.education.notes}
        </p>
      </div>
    </section>

    <!-- Theatrical Fabrication Credits (Chronological Structured Table) -->
    <section class="py-12 border-b border-artisan-300">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-widest text-paper-600 font-semibold">
            Production Experience
          </h2>
          <h3 class="font-serif text-3xl text-paper-900 font-medium mt-1">
            Theatrical Fabrication Credits
          </h3>
        </div>
        <span class="text-xs font-mono text-paper-600 hidden sm:block">
          Chronological Order (2023 – Present)
        </span>
      </div>

      <div class="space-y-10">
        {resumeData.theatricalCredits.map((yearGroup) => (
          <div class="space-y-4">
            <!-- Year Header Banner -->
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm font-bold text-artisan-800 bg-paper-200 px-3 py-0.5 rounded border border-artisan-300">
                {yearGroup.year}
              </span>
              <div class="h-px bg-artisan-300 flex-grow"></div>
            </div>

            <!-- Table of Productions in Year -->
            <div class="overflow-hidden bg-paper-50 rounded-xl border border-artisan-300 shadow-2xs">
              <!-- Desktop Table Header -->
              <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3.5 bg-paper-200/70 border-b border-artisan-300 text-xs font-mono uppercase tracking-wider text-paper-700 font-semibold">
                <div class="col-span-3">Role</div>
                <div class="col-span-4">Production</div>
                <div class="col-span-5">Venue &amp; Organization</div>
              </div>

              <!-- Production Rows -->
              <div class="divide-y divide-paper-200">
                {yearGroup.productions.map((prod) => (
                  <div class="p-5 sm:p-6 md:grid md:grid-cols-12 md:gap-4 items-center hover:bg-paper-100/60 transition-colors">
                    <!-- Role -->
                    <div class="col-span-3 mb-2 md:mb-0">
                      <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-paper-200 text-paper-900 border border-artisan-300/80">
                        {prod.role}
                      </span>
                    </div>

                    <!-- Production -->
                    <div class="col-span-4 mb-2 md:mb-0">
                      <h4 class="font-serif text-lg text-paper-900 font-medium italic">
                        {prod.production}
                      </h4>
                      {prod.details && (
                        <p class="text-xs text-paper-600 font-sans mt-0.5">
                          {prod.details}
                        </p>
                      )}
                    </div>

                    <!-- Venue -->
                    <div class="col-span-5 text-sm text-paper-700 font-sans">
                      {prod.venue}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical & Craft Skills Section -->
    <section class="py-12 border-b border-artisan-300">
      <h2 class="text-xs font-mono uppercase tracking-widest text-paper-600 font-semibold mb-2">
        Artisan Competencies
      </h2>
      <h3 class="font-serif text-3xl text-paper-900 font-medium mb-8">
        Technical Fabrication Skills
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {resumeData.skills.map((category) => (
          <div class="bg-paper-50 p-6 rounded-xl border border-artisan-300 shadow-2xs flex flex-col justify-between">
            <div>
              <h4 class="font-serif text-xl text-paper-900 font-medium mb-4 pb-2 border-b border-paper-200">
                {category.category}
              </h4>
              <ul class="space-y-2">
                {category.skills.map((skill) => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-paper-800 font-sans font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-artisan-600 mt-1.5 shrink-0"></span>
                    <span>{skill}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Action Card -->
    <div class="mt-12 p-8 sm:p-10 rounded-2xl bg-paper-200/60 border border-artisan-300 text-center flex flex-col items-center">
      <h3 class="font-serif text-2xl sm:text-3xl text-paper-900 font-medium">
        Looking for a complete theatrical fabrication portfolio?
      </h3>
      <p class="text-sm text-paper-700 max-w-xl mt-2 leading-relaxed font-sans">
        Download Aurelia's printable résumé formatted with full production contact information, faculty references, and detailed technical credits.
      </p>
      <a
        href={resumeData.pdfUrl}
        target="_blank"
        download="Aurelia_Sims_Resume.pdf"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-paper-900 text-paper-50 hover:bg-artisan-700 font-medium text-sm transition-colors shadow-xs"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Download PDF Resume (/AureliaS.resume.pdf)
      </a>
    </div>
  </div>
</BaseLayout>
