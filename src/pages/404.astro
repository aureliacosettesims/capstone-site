---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Aurelia Cosette Sims"
  description="The page you are looking for does not exist."
>
  <div class="max-w-3xl mx-auto px-6 sm:px-8 py-24 sm:py-32 text-center">
    <span class="text-xs font-mono uppercase tracking-widest text-paper-600 font-semibold">
      404 Error
    </span>
    <h1 class="font-serif text-4xl sm:text-6xl text-paper-900 font-medium tracking-tight mt-3">
      Page Not Found
    </h1>
    <p class="mt-4 text-base sm:text-lg text-paper-700 font-sans max-w-md mx-auto leading-relaxed">
      The work or page you are looking for has been moved or does not exist.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-paper-900 text-paper-50 hover:bg-artisan-700 font-medium text-sm transition-colors shadow-xs"
      >
        &larr; Return to Work Gallery
      </a>
    </div>
  </div>
</BaseLayout>
